{
  "expo": {
    "name": "ID Tjek",
    "slug": "idcheck",
    "version": "1.0.0",
    "description": "Skan kundens alders-QR-kode for hurtigt at bekræfte, at de er 18 år eller derover.",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "idcheck",
    "userInterfaceStyle": "automatic",
    "backgroundColor": "#0A7CEF",
    "locales": {
      "da": "./assets/locales/da.json",
      "en": "./assets/locales/en.json"
    },
    "ios": {
      "icon": "./assets/images/icon.png",
      "bundleIdentifier": "dk.jonathanb.idcheck",
      "supportsTablet": true,
      "config": {
        "usesNonExemptEncryption": false
      }
    },
    "android": {
      "blockedPermissions": [
        "android.permission.RECORD_AUDIO"
      ],
      "adaptiveIcon": {
        "backgroundColor": "#0A7CEF",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "dk.jonathanb.idcheck",
      "permissions": [
        "android.permission.CAMERA"
      ]
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#0A7CEF",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200,
          "android": {
            "image": "./assets/images/splash-icon.png",
            "imageWidth": 200
          }
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "$(PRODUCT_NAME) uses the camera to scan age-verification QR codes."
        }
      ],
      "expo-localization",
      "./plugins/withAndroidDefaultLocaleStrings"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "28883fc2-3b0c-4092-92ac-57a3933c5cd5"
      }
    }
  }
}
